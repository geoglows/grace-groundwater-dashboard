# ---- Deployment -------------------------------------------------------------
VITE_BASE_PATH=/
VITE_SUPABASE_URL=https://oreyydrsbsghgulhmgzx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Lij4Ly_vB9nu5EjHRznfGg_QQ2poTYj

# ---- Header -----------------------------------------------------------------
VITE_LOGO_SRC=/geoglows-logo-nav.png
VITE_LOGO_HREF="/#"
VITE_LOGO_ALT=GEOGLOWS

# ---- The camera the map opens on --------------------------------------------
# basemap: any ArcGIS basemap id, e.g. [gray-vector, streets-vector, topo-vector, satellite, hybrid, osm, dark-gray-vector]
VITE_MAP_DEFAULT_BASEMAP=gray-vector
VITE_MAP_CENTER_LON=0
VITE_MAP_CENTER_LAT=20
VITE_MAP_ZOOM=5

# ---- What the app opens with ------------------------------------------------
# view: [global, aquifer] — the whole-world animation, or the aquifer outlines
VITE_DEFAULT_VIEW=global
VITE_DEFAULT_VARIABLE=GWSa
VITE_PREFETCH_VARIABLES=GWSa,TWSa
VITE_SETTINGS_HALF_DEGREE_CELLS=false
VITE_ZARR_URL_ONE_DEGREE=https://d3hbj0z0f67zhd.cloudfront.net/ggg/grace-gldas-water-balance-1.0.zarr
VITE_ZARR_URL_HALF_DEGREE=https://d3hbj0z0f67zhd.cloudfront.net/ggg/grace-gldas-water-balance-0.5.zarr
# LOCAL_ZARR_DIR=/
# VITE_ZARR_URL_ONE_DEGREE=/local-zarr/grace-gldas-water-balance-1.0.zarr
# VITE_ZARR_URL_HALF_DEGREE=/local-zarr/grace-gldas-water-balance-0.5.zarr

# ---- Layer appearance -------------------------------------------------------
# palette: [default, viridis, cividis, brown-teal, purple-green, rainbow]
VITE_DEFAULT_COLOR_PALETTE=default
VITE_SETTINGS_LAYER_OPACITY=1
VITE_SETTINGS_SHOW_CELL_BORDERS=false
VITE_SETTINGS_CELL_BORDER_WIDTH=0.5

# ---- GRACE mascon footprints ------------------------------------------------
VITE_SETTINGS_SHOW_MASCONS=false
VITE_SETTINGS_MASCON_WIDTH=0.5
VITE_GRACE_MASCON_URL=/grace-mascons-land.json

# ---- Color bar --------------------------------------------------------------
VITE_SETTINGS_MAP_LEGEND_VISIBLE=true
VITE_SETTINGS_DYNAMIC_COLOR_SCALE=true
VITE_SETTINGS_FIXED_COLOR_SCALE_MAX=30
VITE_UNITS_LABEL=cm
VITE_VALUE_LABEL=Liquid Water Equivalent

# ---- Layout -----------------------------------------------------------------
VITE_CHART_PANEL_PERCENT=32
VITE_CHART_PANEL_MIN_PERCENT=12
VITE_CHART_PANEL_MAX_PERCENT=80

# ---- Animation --------------------------------------------------------------
VITE_GLOBAL_PLAY_RATE_MS=250
VITE_REGIONAL_PLAY_RATE_MS=1000
